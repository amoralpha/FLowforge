@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find dependencies that FlowForge depends on
# Note: Consumers of FlowForge must have these available.
find_dependency(Threads REQUIRED)
find_dependency(fmt REQUIRED)

if(@FLOWFORGE_BUILD_TESTS@)
    find_dependency(Catch2 REQUIRED)
endif()

# Include the exported targets
include("${CMAKE_CURRENT_LIST_DIR}/FlowForgeTargets.cmake")

check_required_components(FlowForge)
