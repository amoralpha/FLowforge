{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development Build",
      "description": "Debug build with warnings; sanitizers are configured separately",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FLOWFORGE_BUILD_TESTS": "ON",
        "FLOWFORGE_BUILD_BENCHMARKS": "ON",
        "FLOWFORGE_BUILD_EXAMPLES": "ON",
        "FLOWFORGE_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan + UBSan (Linux)",
      "description": "Debug build with AddressSanitizer and fail-fast UndefinedBehaviorSanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/asan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "FLOWFORGE_BUILD_TESTS": "ON",
        "FLOWFORGE_BUILD_BENCHMARKS": "OFF",
        "FLOWFORGE_BUILD_EXAMPLES": "OFF",
        "FLOWFORGE_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release Build",
      "description": "Optimized release build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FLOWFORGE_BUILD_TESTS": "OFF",
        "FLOWFORGE_BUILD_BENCHMARKS": "OFF",
        "FLOWFORGE_BUILD_EXAMPLES": "OFF",
        "FLOWFORGE_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Release with Debug Info",
      "description": "Optimized build with debug symbols for profiling",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "FLOWFORGE_BUILD_TESTS": "ON",
        "FLOWFORGE_BUILD_BENCHMARKS": "ON",
        "FLOWFORGE_BUILD_EXAMPLES": "ON",
        "FLOWFORGE_BUILD_CLI": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1",
        "UBSAN_OPTIONS": "halt_on_error=1"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
